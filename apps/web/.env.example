# Copy this to .env.local and fill in your deployed Worker URL.
# Local dev against `wrangler dev --local --port 8787`:
VITE_API_BASE_URL=http://localhost:8787
VITE_WS_BASE_URL=ws://localhost:8787

# Production, once deployed:
# VITE_API_BASE_URL=https://fruitvc-api.yoursubdomain.workers.dev
# VITE_WS_BASE_URL=wss://fruitvc-api.yoursubdomain.workers.dev
